<?xml version="1.0" encoding="UTF-8"?>

<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:modeler="http://camunda.org/schema/modeler/1.0"
    id="Definitions_GoodsReceipt"
    targetNamespace="http://bpmn.io/schema/bpmn"
    exporter="Camunda Modeler"
    exporterVersion="5.51.1"
    modeler:executionPlatform="Camunda Cloud"
    modeler:executionPlatformVersion="8.9.0">

  <!-- ====================================================== -->
  <!-- ПРОЦЕСС -->
  <!-- ====================================================== -->

  <bpmn:process
      id="Process_GoodsReceipt"
      name="Приёмка готовой продукции"
      isExecutable="false">

    <!-- ================================================== -->
    <!-- ДОРОЖКИ -->
    <!-- ================================================== -->

    <bpmn:laneSet id="LaneSet_Main">

      <bpmn:lane
          id="Lane_ProjectManager"
          name="Руководитель проекта">

        <bpmn:flowNodeRef>StartEvent_ProductReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendArrivalLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewSupplierDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDocumentsAccounting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>

      </bpmn:lane>

      <bpmn:lane
          id="Lane_FinancialManager"
          name="Финансовый менеджер">

        <bpmn:flowNodeRef>Task_CreatePackingList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateUnloadingNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendWarehouseDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceivePackingList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateCost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateFinalUnloadingNote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFinalUnloadingNote</bpmn:flowNodeRef>

      </bpmn:lane>

      <bpmn:lane
          id="Lane_WarehouseManager"
          name="Кладовщик">

        <bpmn:flowNodeRef>Task_ReceiveGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckGoodsDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnloadGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CountGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateInventoryCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordActualQuantity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPackingList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveSupplierDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendSupplierDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveMismatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>

      </bpmn:lane>

      <bpmn:lane
          id="Lane_Accounting"
          name="Бухгалтерия">

        <bpmn:flowNodeRef>Task_ReceiveAccountingDocuments</bpmn:flowNodeRef>

      </bpmn:lane>

    </bpmn:laneSet>


    <!-- ================================================== -->
    <!-- СТАРТОВОЕ СОБЫТИЕ -->
    <!-- ================================================== -->

    <bpmn:startEvent
        id="StartEvent_ProductReady"
        name="Готовая продукция поступила">

      <bpmn:outgoing>Flow_Start_SendLetter</bpmn:outgoing>

    </bpmn:startEvent>


    <!-- ================================================== -->
    <!-- РУКОВОДИТЕЛЬ ПРОЕКТА -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_SendArrivalLetter"
        name="Направить письмо о поступлении продукции">

      <bpmn:incoming>Flow_Start_SendLetter</bpmn:incoming>
      <bpmn:outgoing>Flow_Letter_CreateDocuments</bpmn:outgoing>

    </bpmn:userTask>


    <!-- ================================================== -->
    <!-- ФИНАНСОВЫЙ МЕНЕДЖЕР -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_CreatePackingList"
        name="Создать упаковочный лист">

      <bpmn:incoming>Flow_Letter_CreateDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatePacking_CreateUnloading</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_CreateUnloadingNote"
        name="Создать накладную на разгрузку">

      <bpmn:incoming>Flow_CreatePacking_CreateUnloading</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateUnloading_SendWarehouse</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_SendWarehouseDocuments"
        name="Направить документы кладовщику">

      <bpmn:incoming>Flow_CreateUnloading_SendWarehouse</bpmn:incoming>
      <bpmn:outgoing>Flow_SendWarehouse_ReceiveGoods</bpmn:outgoing>

    </bpmn:userTask>


    <!-- ================================================== -->
    <!-- КЛАДОВЩИК -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_ReceiveGoods"
        name="Принять прибывший груз">

      <bpmn:incoming>Flow_SendWarehouse_ReceiveGoods</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_CheckDocuments</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_CheckGoodsDocuments"
        name="Проверить соответствие груза документам">

      <bpmn:incoming>Flow_Receive_CheckDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckDocuments_Gateway</bpmn:outgoing>

    </bpmn:userTask>


    <!-- ================================================== -->
    <!-- XOR: СООТВЕТСТВИЕ -->
    <!-- ================================================== -->

    <bpmn:exclusiveGateway
        id="Gateway_DocumentsMatch"
        name="Груз соответствует документам?">

      <bpmn:incoming>Flow_CheckDocuments_Gateway</bpmn:incoming>

      <bpmn:outgoing>Flow_Match_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Match_No</bpmn:outgoing>

    </bpmn:exclusiveGateway>


    <!-- ================================================== -->
    <!-- НЕСООТВЕТСТВИЕ -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_ResolveMismatch"
        name="Устранить несоответствие груза">

      <bpmn:incoming>Flow_Match_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Mismatch_End</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:endEvent
        id="EndEvent_Failure"
        name="Несоответствие груза не устранено">

      <bpmn:incoming>Flow_Mismatch_End</bpmn:incoming>

    </bpmn:endEvent>


    <!-- ================================================== -->
    <!-- РАЗГРУЗКА И РАЗМЕЩЕНИЕ -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_UnloadGoods"
        name="Организовать разгрузку">

      <bpmn:incoming>Flow_Match_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Unload_Count</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_CountGoods"
        name="Проверить количество товара">

      <bpmn:incoming>Flow_Unload_Count</bpmn:incoming>
      <bpmn:outgoing>Flow_Count_Place</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_PlaceGoods"
        name="Разместить товар на складе">

      <bpmn:incoming>Flow_Count_Place</bpmn:incoming>
      <bpmn:outgoing>Flow_Place_UpdateCard</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_UpdateInventoryCard"
        name="Заполнить карточку учета товаров">

      <bpmn:incoming>Flow_Place_UpdateCard</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateCard_RecordQuantity</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_RecordActualQuantity"
        name="Записать фактическое количество товара">

      <bpmn:incoming>Flow_UpdateCard_RecordQuantity</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordQuantity_SendPackingList</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_SendPackingList"
        name="Передать упаковочный лист финансовому менеджеру">

      <bpmn:incoming>Flow_RecordQuantity_SendPackingList</bpmn:incoming>
      <bpmn:outgoing>Flow_SendPackingList_ReceivePackingList</bpmn:outgoing>

    </bpmn:userTask>


    <!-- ================================================== -->
    <!-- ФИНАНСОВЫЙ МЕНЕДЖЕР: СЕБЕСТОИМОСТЬ -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_ReceivePackingList"
        name="Получить упаковочный лист">

      <bpmn:incoming>Flow_SendPackingList_ReceivePackingList</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceivePacking_CalculateCost</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_CalculateCost"
        name="Рассчитать себестоимость товара">

      <bpmn:incoming>Flow_ReceivePacking_CalculateCost</bpmn:incoming>
      <bpmn:outgoing>Flow_Calculate_CreateFinalNote</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_CreateFinalUnloadingNote"
        name="Создать накладную на разгрузку">

      <bpmn:incoming>Flow_Calculate_CreateFinalNote</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalNote_SendWarehouse</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_SendFinalUnloadingNote"
        name="Направить накладную кладовщику">

      <bpmn:incoming>Flow_FinalNote_SendWarehouse</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalNote_End</bpmn:outgoing>

    </bpmn:userTask>


    <!-- ================================================== -->
    <!-- ДОКУМЕНТЫ ОТ ПОСТАВЩИКА -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_ReceiveSupplierDocuments"
        name="Получить документы поставщика">

      <bpmn:outgoing>Flow_ReceiveSupplier_SendManager</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_SendSupplierDocuments"
        name="Передать документы руководителю проекта">

      <bpmn:incoming>Flow_ReceiveSupplier_SendManager</bpmn:incoming>
      <bpmn:outgoing>Flow_SendSupplier_Review</bpmn:outgoing>

    </bpmn:userTask>


    <!-- ================================================== -->
    <!-- РУКОВОДИТЕЛЬ ПРОЕКТА: ПРОВЕРКА -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_ReviewSupplierDocuments"
        name="Проверить документы поставщика">

      <bpmn:incoming>Flow_SendSupplier_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_SendAccounting</bpmn:outgoing>

    </bpmn:userTask>


    <bpmn:userTask
        id="Task_SendDocumentsAccounting"
        name="Передать документы в бухгалтерию">

      <bpmn:incoming>Flow_Review_SendAccounting</bpmn:incoming>
      <bpmn:outgoing>Flow_SendAccounting_Receive</bpmn:outgoing>

    </bpmn:userTask>


    <!-- ================================================== -->
    <!-- БУХГАЛТЕРИЯ -->
    <!-- ================================================== -->

    <bpmn:userTask
        id="Task_ReceiveAccountingDocuments"
        name="Принять документы">

      <bpmn:incoming>Flow_SendAccounting_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_Accounting_Success</bpmn:outgoing>

    </bpmn:userTask>


    <!-- ================================================== -->
    <!-- УСПЕШНОЕ ЗАВЕРШЕНИЕ -->
    <!-- ================================================== -->

    <bpmn:endEvent
        id="EndEvent_Success"
        name="Документы переданы в бухгалтерию">

      <bpmn:incoming>Flow_Accounting_Success</bpmn:incoming>

    </bpmn:endEvent>


    <!-- ================================================== -->
    <!-- ПОТОКИ УПРАВЛЕНИЯ -->
    <!-- ================================================== -->

    <bpmn:sequenceFlow
        id="Flow_Start_SendLetter"
        sourceRef="StartEvent_ProductReady"
        targetRef="Task_SendArrivalLetter" />


    <bpmn:sequenceFlow
        id="Flow_Letter_CreateDocuments"
        sourceRef="Task_SendArrivalLetter"
        targetRef="Task_CreatePackingList" />


    <bpmn:sequenceFlow
        id="Flow_CreatePacking_CreateUnloading"
        sourceRef="Task_CreatePackingList"
        targetRef="Task_CreateUnloadingNote" />


    <bpmn:sequenceFlow
        id="Flow_CreateUnloading_SendWarehouse"
        sourceRef="Task_CreateUnloadingNote"
        targetRef="Task_SendWarehouseDocuments" />


    <bpmn:sequenceFlow
        id="Flow_SendWarehouse_ReceiveGoods"
        sourceRef="Task_SendWarehouseDocuments"
        targetRef="Task_ReceiveGoods" />


    <bpmn:sequenceFlow
        id="Flow_Receive_CheckDocuments"
        sourceRef="Task_ReceiveGoods"
        targetRef="Task_CheckGoodsDocuments" />


    <bpmn:sequenceFlow
        id="Flow_CheckDocuments_Gateway"
        sourceRef="Task_CheckGoodsDocuments"
        targetRef="Gateway_DocumentsMatch" />


    <bpmn:sequenceFlow
        id="Flow_Match_Yes"
        name="Да"
        sourceRef="Gateway_DocumentsMatch"
        targetRef="Task_UnloadGoods" />


    <bpmn:sequenceFlow
        id="Flow_Match_No"
        name="Нет"
        sourceRef="Gateway_DocumentsMatch"
        targetRef="Task_ResolveMismatch" />


    <bpmn:sequenceFlow
        id="Flow_Mismatch_End"
        sourceRef="Task_ResolveMismatch"
        targetRef="EndEvent_Failure" />


    <bpmn:sequenceFlow
        id="Flow_Unload_Count"
        sourceRef="Task_UnloadGoods"
        targetRef="Task_CountGoods" />


    <bpmn:sequenceFlow
        id="Flow_Count_Place"
        sourceRef="Task_CountGoods"
        targetRef="Task_PlaceGoods" />


    <bpmn:sequenceFlow
        id="Flow_Place_UpdateCard"
        sourceRef="Task_PlaceGoods"
        targetRef="Task_UpdateInventoryCard" />


    <bpmn:sequenceFlow
        id="Flow_UpdateCard_RecordQuantity"
        sourceRef="Task_UpdateInventoryCard"
        targetRef="Task_RecordActualQuantity" />


    <bpmn:sequenceFlow
        id="Flow_RecordQuantity_SendPackingList"
        sourceRef="Task_RecordActualQuantity"
        targetRef="Task_SendPackingList" />


    <bpmn:sequenceFlow
        id="Flow_SendPackingList_ReceivePackingList"
        sourceRef="Task_SendPackingList"
        targetRef="Task_ReceivePackingList" />


    <bpmn:sequenceFlow
        id="Flow_ReceivePacking_CalculateCost"
        sourceRef="Task_ReceivePackingList"
        targetRef="Task_CalculateCost" />


    <bpmn:sequenceFlow
        id="Flow_Calculate_CreateFinalNote"
        sourceRef="Task_CalculateCost"
        targetRef="Task_CreateFinalUnloadingNote" />


    <bpmn:sequenceFlow
        id="Flow_FinalNote_SendWarehouse"
        sourceRef="Task_CreateFinalUnloadingNote"
        targetRef="Task_SendFinalUnloadingNote" />


    <bpmn:sequenceFlow
        id="Flow_FinalNote_End"
        sourceRef="Task_SendFinalUnloadingNote"
        targetRef="Task_ReceiveSupplierDocuments" />


    <bpmn:sequenceFlow
        id="Flow_ReceiveSupplier_SendManager"
        sourceRef="Task_ReceiveSupplierDocuments"
        targetRef="Task_SendSupplierDocuments" />


    <bpmn:sequenceFlow
        id="Flow_SendSupplier_Review"
        sourceRef="Task_SendSupplierDocuments"
        targetRef="Task_ReviewSupplierDocuments" />


    <bpmn:sequenceFlow
        id="Flow_Review_SendAccounting"
        sourceRef="Task_ReviewSupplierDocuments"
        targetRef="Task_SendDocumentsAccounting" />


    <bpmn:sequenceFlow
        id="Flow_SendAccounting_Receive"
        sourceRef="Task_SendDocumentsAccounting"
        targetRef="Task_ReceiveAccountingDocuments" />


    <bpmn:sequenceFlow
        id="Flow_Accounting_Success"
        sourceRef="Task_ReceiveAccountingDocuments"
        targetRef="EndEvent_Success" />

  </bpmn:process>


  <!-- ====================================================== -->
  <!-- COLLABORATION -->
  <!-- ====================================================== -->

  <bpmn:collaboration
      id="Collaboration_GoodsReceipt"
      name="Взаимодействие при приёмке готовой продукции">

    <!-- Открытый пул -->
    <bpmn:participant
        id="Participant_GoodsReceipt"
        name="Приёмка готовой продукции"
        processRef="Process_GoodsReceipt" />

    <!-- Закрытый пул внешнего контрагента -->
    <bpmn:participant
        id="Participant_Supplier"
        name="Поставщик" />


    <!-- ================================================== -->
    <!-- ПОТОКИ СООБЩЕНИЙ -->
    <!-- ================================================== -->

    <!-- Письмо / уведомление о поступлении -->
    <bpmn:messageFlow
        id="MessageFlow_ArrivalLetter"
        name="Письмо о поступлении продукции"
        sourceRef="Task_SendArrivalLetter"
        targetRef="Participant_Supplier" />


    <!-- Документы поставщика -->
    <bpmn:messageFlow
        id="MessageFlow_SupplierDocuments"
        name="Приложение к договору, товарная накладная, счет-фактура"
        sourceRef="Participant_Supplier"
        targetRef="Task_ReceiveSupplierDocuments" />

  </bpmn:collaboration>


  <!-- ====================================================== -->
  <!-- ГРАФИЧЕСКАЯ ЧАСТЬ -->
  <!-- ====================================================== -->

  <bpmndi:BPMNDiagram
      id="BPMNDiagram_GoodsReceipt">

    <!-- ВАЖНО:
         Plane ссылается на Collaboration,
         а не на Participant или Process.
    -->

    <bpmndi:BPMNPlane
        id="BPMNPlane_GoodsReceipt"
        bpmnElement="Collaboration_GoodsReceipt">


      <!-- ================================================== -->
      <!-- ПУЛ ПРИЁМКИ -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Participant_GoodsReceipt_di"
          bpmnElement="Participant_GoodsReceipt"
          isHorizontal="true">

        <dc:Bounds
            x="100"
            y="100"
            width="2600"
            height="650" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- ДОРОЖКА РУКОВОДИТЕЛЯ -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Lane_ProjectManager_di"
          bpmnElement="Lane_ProjectManager"
          isHorizontal="true">

        <dc:Bounds
            x="130"
            y="100"
            width="2570"
            height="150" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- ДОРОЖКА ФИНАНСОВОГО МЕНЕДЖЕРА -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Lane_FinancialManager_di"
          bpmnElement="Lane_FinancialManager"
          isHorizontal="true">

        <dc:Bounds
            x="130"
            y="250"
            width="2570"
            height="170" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- ДОРОЖКА КЛАДОВЩИКА -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Lane_WarehouseManager_di"
          bpmnElement="Lane_WarehouseManager"
          isHorizontal="true">

        <dc:Bounds
            x="130"
            y="420"
            width="2570"
            height="180" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- ДОРОЖКА БУХГАЛТЕРИИ -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Lane_Accounting_di"
          bpmnElement="Lane_Accounting"
          isHorizontal="true">

        <dc:Bounds
            x="130"
            y="600"
            width="2570"
            height="150" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- ПУЛ ПОСТАВЩИКА -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Participant_Supplier_di"
          bpmnElement="Participant_Supplier"
          isHorizontal="true">

        <dc:Bounds
            x="100"
            y="800"
            width="2600"
            height="100" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- START -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="StartEvent_ProductReady_di"
          bpmnElement="StartEvent_ProductReady">

        <dc:Bounds
            x="180"
            y="157"
            width="36"
            height="36" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- SEND LETTER -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Task_SendArrivalLetter_di"
          bpmnElement="Task_SendArrivalLetter">

        <dc:Bounds
            x="260"
            y="135"
            width="150"
            height="80" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- FINANCIAL TASKS -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Task_CreatePackingList_di"
          bpmnElement="Task_CreatePackingList">

        <dc:Bounds
            x="470"
            y="275"
            width="150"
            height="80" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <bpmndi:BPMNShape
          id="Task_CreateUnloadingNote_di"
          bpmnElement="Task_CreateUnloadingNote">

        <dc:Bounds
            x="670"
            y="275"
            width="150"
            height="80" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <bpmndi:BPMNShape
          id="Task_SendWarehouseDocuments_di"
          bpmnElement="Task_SendWarehouseDocuments">

        <dc:Bounds
            x="870"
            y="275"
            width="170"
            height="80" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <!-- ================================================== -->
      <!-- WAREHOUSE -->
      <!-- ================================================== -->

      <bpmndi:BPMNShape
          id="Task_ReceiveGoods_di"
          bpmnElement="Task_ReceiveGoods">

        <dc:Bounds
            x="1090"
            y="465"
            width="140"
            height="80" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <bpmndi:BPMNShape
          id="Task_CheckGoodsDocuments_di"
          bpmnElement="Task_CheckGoodsDocuments">

        <dc:Bounds
            x="1260"
            y="465"
            width="160"
            height="80" />

        <bpmndi:BPMNLabel />

      </bpmndi:BPMNShape>


      <bpmndi:BPMNShape
          id="Gateway_DocumentsMatch_di"
          bpmnElement="Gateway_DocumentsMatch"
          isMarkerVisible="true">

        <dc:Bounds
            x="1455"
            y="480"
